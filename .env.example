# ============================
# AI Robot Platform Configuration
# ============================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-robot
MONGODB_DB_NAME=ai-robot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=change-this-to-a-strong-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# AI Models
FAST_MODEL=gemini-2.0-flash
THINKING_MODEL=gemini-2.0-pro
VOICE_MODEL=gemini-2.0-flash-live

# Voice Configuration
VOICE_MODE=native
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,my

# MQTT
MQTT_PORT=1883
MQTT_HOST=localhost
MQTT_USERNAME=
MQTT_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BIT_DEPTH=16
AUDIO_CHUNK_SIZE=4096
MAX_AUDIO_FILE_SIZE=52428800

# Storage
AUDIO_STORAGE_TYPE=gridfs

# Timezone
DEFAULT_TIMEZONE=Asia/Yangon

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# AI Services (Python)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# Ollama (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=false

